.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.field-label {
  width: 150rpx;
  font-size: 27rpx;
}

.field-input {
  width: 240rpx;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-family: Menlo, Consolas, monospace;
  text-align: right;
}

.cap-input {
  width: 180rpx;
  margin-right: 16rpx;
}

.seg-bar {
  display: flex;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 6rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #666;
  border-radius: 8rpx;
}

.seg.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

.unit-bar {
  flex: 1;
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.preset {
  padding: 8rpx 24rpx;
  background: #f5f6fa;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #666;
  margin: 0 14rpx 10rpx 0;
}

.error-card {
  background: #fdecea;
  color: #e53935;
  border-radius: 14rpx;
  margin: 0 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rc-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.rc-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #4A90E2;
}

.rc-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #666;
}

.charge-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
}

.charge-row:last-of-type {
  border-bottom: none;
}

.charge-pct {
  font-size: 26rpx;
  color: #333;
}

.charge-time {
  font-size: 26rpx;
  color: #4A90E2;
  font-family: Menlo, Consolas, monospace;
  font-weight: 600;
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.formula-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
}

.formula {
  font-size: 26rpx;
  color: #333;
  font-family: Menlo, Consolas, monospace;
  padding: 8rpx 0;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
