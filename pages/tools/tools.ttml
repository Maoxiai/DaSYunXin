<view class="cat-block" tt:for="{{categories}}" tt:for-item="cat" tt:key="name">
  <view class="cat-title">{{cat.name}}</view>
  <view class="tool-grid">
    <view
      class="tool-item anim"
      tt:for="{{cat.tools}}"
      tt:for-item="tool"
      tt:key="id"
      bindtap="openTool"
      data-id="{{tool.id}}"
      style="animation-delay: {{tool._delay}}ms"
    >
      <text class="tool-icon">{{tool.icon}}</text>
      <text class="tool-name">{{tool.name}}</text>
      <text class="tool-desc">{{tool.desc}}</text>
    </view>
  </view>
</view>
<view class="foot-tip">全部工具离线可用</view>
