.seg-bar {
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  margin: 20rpx;
  padding: 8rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
}

.seg.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.num-input {
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-family: Menlo, Consolas, monospace;
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.preset {
  padding: 10rpx 28rpx;
  background: #f5f6fa;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #666;
  margin: 0 14rpx 10rpx 0;
}

.preset.active {
  background: rgba(74, 144, 226, 0.12);
  color: #4A90E2;
  font-weight: 600;
}

.two-col {
  display: flex;
  justify-content: space-between;
}

.col-item {
  width: 320rpx;
}

.col-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.error-card {
  background: #fdecea;
  color: #e53935;
  border-radius: 14rpx;
  margin: 0 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rc-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.rc-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #4A90E2;
}

.rc-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #666;
}

.target-row {
  display: flex;
  align-items: center;
}

.target-input {
  flex: 1;
  margin-right: 16rpx;
}

.unit-bar {
  margin: 0;
  width: 300rpx;
  flex: none;
  padding: 6rpx;
}

.unit-bar .seg {
  padding: 12rpx 0;
  font-size: 24rpx;
}

.sug-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 16rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.sug-params {
  font-size: 34rpx;
  font-weight: bold;
  font-family: Menlo, Consolas, monospace;
  margin-bottom: 10rpx;
}

.sug-detail {
  font-size: 24rpx;
  color: #666;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
