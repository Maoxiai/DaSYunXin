.seg-bar {
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  margin: 20rpx;
  padding: 8rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
}

.seg.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.hex-input {
  height: 160rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-family: Menlo, Consolas, monospace;
  width: 100%;
  box-sizing: border-box;
}

.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #999;
}

.error-card {
  background: #fdecea;
  color: #e53935;
  border-radius: 14rpx;
  margin: 0 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rc-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.rc-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #4A90E2;
  font-family: Menlo, Consolas, monospace;
}

.rc-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
