.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.seg-bar {
  display: flex;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: #666;
  border-radius: 8rpx;
}

.seg.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

.num-input {
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-family: Menlo, Consolas, monospace;
}

.unit-row {
  display: flex;
  align-items: center;
}

.unit-input {
  flex: 1;
  margin-right: 16rpx;
}

.unit-bar {
  width: 340rpx;
  flex: none;
  margin-bottom: 0;
}

.unit-bar .seg {
  padding: 10rpx 0;
  font-size: 22rpx;
}

.mini-result {
  margin-top: 20rpx;
  padding: 22rpx;
  background: rgba(74, 144, 226, 0.06);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
}

.mr-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A90E2;
}

.mr-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.preset {
  padding: 10rpx 24rpx;
  background: #f5f6fa;
  border-radius: 26rpx;
  font-size: 24rpx;
  color: #666;
  margin: 0 14rpx 10rpx 0;
}

.preset.active {
  background: rgba(74, 144, 226, 0.12);
  color: #4A90E2;
  font-weight: 600;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
