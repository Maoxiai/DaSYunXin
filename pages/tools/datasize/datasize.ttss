.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.num-input {
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-family: Menlo, Consolas, monospace;
}

.seg-bar {
  display: flex;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-top: 16rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666;
  border-radius: 8rpx;
}

.seg.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

.error-card {
  background: #fdecea;
  color: #e53935;
  border-radius: 14rpx;
  margin: 0 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 30rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.out-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
}

.out-row:last-child {
  border-bottom: none;
}

.out-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.out-value {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #4A90E2;
  font-family: Menlo, Consolas, monospace;
  text-align: right;
  word-break: break-all;
}

.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
