/* 环数切换 */
.seg-bar {
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  margin: 20rpx;
  padding: 8rpx;
}

.seg {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}

.seg.active {
  background: #4A90E2;
  color: #fff;
  font-weight: 600;
}

/* 电阻可视化 */
.resistor-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.wire {
  width: 90rpx;
  height: 10rpx;
  background: #b8bdc9;
}

.resistor-body {
  display: flex;
  align-items: stretch;
  height: 90rpx;
  background: #e8d5b0;
  border-radius: 20rpx;
  border: 2rpx solid #d4b483;
  padding: 0 6rpx;
  overflow: hidden;
}

.band {
  width: 26rpx;
  height: 100%;
  margin: 0 8rpx;
  border-radius: 4rpx;
}

/* 结果卡片 */
.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rc-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
}

.rc-detail {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #999;
}

/* 环配置 */
.band-config {
  margin: 0 20rpx 20rpx;
}

.band-row {
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.band-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 108rpx;
  padding: 10rpx 0;
  border-radius: 10rpx;
  border: 3rpx solid transparent;
  margin-bottom: 6rpx;
}

.color-item.selected {
  border-color: #4A90E2;
  background: rgba(74, 144, 226, 0.06);
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.15);
  margin-bottom: 6rpx;
}

.color-name {
  font-size: 22rpx;
  color: #333;
}

.color-sub {
  font-size: 20rpx;
  color: #999;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
