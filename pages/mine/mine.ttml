<!-- 数据统计卡片 -->
<view class="stats-card">
  <view class="stat-item" bindtap="goFavorites">
    <text class="stat-num">{{favCount}}</text>
    <text class="stat-label">我的收藏</text>
  </view>
  <view class="stat-divider"></view>
  <view class="stat-item" bindtap="goHistory">
    <text class="stat-num">{{viewCount}}</text>
    <text class="stat-label">浏览历史</text>
  </view>
</view>

<!-- 收藏预览 -->
<view class="panel">
  <view class="panel-header">
    <text class="panel-title">我的收藏</text>
    <text class="link-btn" tt:if="{{favCount > 0}}" bindtap="goFavorites">查看全部 {{favCount}} 条 ›</text>
  </view>
  <block tt:if="{{favPreview.length > 0}}">
    <view class="list-row anim" tt:for="{{favPreview}}" tt:key="id" style="animation-delay: {{item._delay}}ms">
      <view class="row-main" bindtap="openDetail" data-id="{{item.id}}">
        <text class="row-model">{{item.model}}</text>
        <text class="row-sub">{{item.vendor}} · {{item.category}}</text>
      </view>
      <text class="row-del" catchtap="removeFav" data-id="{{item.id}}">✕</text>
    </view>
  </block>
  <view class="empty-tip" tt:else>暂无收藏，去首页看看热门芯片吧</view>
</view>

<!-- 浏览历史预览 -->
<view class="panel">
  <view class="panel-header">
    <text class="panel-title">浏览历史</text>
    <view class="header-actions">
      <text class="link-btn" tt:if="{{viewCount > 0}}" bindtap="clearViews">清空</text>
      <text class="link-btn" tt:if="{{viewCount > 0}}" bindtap="goHistory">全部 {{viewCount}} ›</text>
    </view>
  </view>
  <block tt:if="{{viewPreview.length > 0}}">
    <view class="list-row anim" tt:for="{{viewPreview}}" tt:key="id" style="animation-delay: {{item._delay}}ms">
      <view class="row-main" bindtap="openDetail" data-id="{{item.id}}">
        <text class="row-model">{{item.model}}</text>
        <text class="row-sub">{{item.vendor}}</text>
      </view>
    </view>
  </block>
  <view class="empty-tip" tt:else>暂无浏览记录</view>
</view>

<!-- 关于 -->
<view class="about-card">
  <view class="logo-wrap">
    <view class="logo-halo"></view>
    <view class="logo">⚡</view>
  </view>
  <text class="app-name">猫夏云芯</text>
  <text class="app-slogan">嵌入式开发者的芯片速查与工具箱</text>
  <view class="feature-tags">
    <view class="ftag" style="animation-delay: 200ms">🔍 芯片速查</view>
    <view class="ftag" style="animation-delay: 300ms">📊 参数速览</view>
    <view class="ftag" style="animation-delay: 400ms">🧰 工具箱</view>
    <view class="ftag" style="animation-delay: 500ms">📴 离线可用</view>
  </view>
  <view class="app-version">V2.0.0 · 芯片库持续扩充中</view>
  <view class="feedback-btn" hover-class="feedback-hover" bindtap="copyFeedback">💬 意见反馈</view>
</view>
