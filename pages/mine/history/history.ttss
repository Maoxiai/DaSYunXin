.count-bar {
  margin: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #4A90E2, #6aa6f0);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.25);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.count-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin: 0 4rpx;
}

.clear-link {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
}

.list-area {
  padding: 0 20rpx 40rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.anim {
  animation: fadeInUp 0.4s ease both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-model {
  font-size: 30rpx;
  font-weight: 600;
}

.item-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  animation: floaty 2.6s ease-in-out infinite;
}

@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
