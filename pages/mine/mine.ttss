/* 数据统计卡片 */
.stats-card {
  margin: 20rpx;
  padding: 32rpx 20rpx;
  background: linear-gradient(135deg, #4A90E2, #6aa6f0);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 226, 0.3);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.35);
}

/* 面板 */
.panel {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: bold;
}

.header-actions {
  display: flex;
  align-items: center;
}

.header-actions .link-btn {
  margin-left: 24rpx;
}

.link-btn {
  font-size: 24rpx;
  color: #4A90E2;
}

/* 列表 */
.list-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
}

.list-row:last-child {
  border-bottom: none;
}

.anim {
  animation: fadeInUp 0.4s ease both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes popIn {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.row-model {
  font-size: 28rpx;
  font-weight: 600;
}

.row-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.row-del {
  padding: 10rpx 6rpx 10rpx 20rpx;
  color: #c2c7d1;
  font-size: 26rpx;
}

.empty-tip {
  padding: 30rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

/* 关于（深色渐变品牌卡片） */
.about-card {
  position: relative;
  overflow: hidden;
  margin: 20rpx;
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(160deg, #1a2a4a, #2d4a7a 55%, #3a5a9a);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 42, 74, 0.35);
}

.logo-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-halo {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(120, 170, 255, 0.45);
  animation: haloPulse 2.5s ease-in-out infinite;
}

.logo {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6aa6f0, #4A90E2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.5);
  animation: logoFloat 3s ease-in-out infinite;
}

@keyframes haloPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.35); opacity: 0.15; }
}

@keyframes logoFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.app-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  animation: fadeInUp 0.6s ease both;
  text-shadow: 0 2rpx 12rpx rgba(120, 170, 255, 0.6);
}

.app-slogan {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  animation: fadeInUp 0.6s ease 0.1s both;
}

.feature-tags {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.ftag {
  padding: 10rpx 24rpx;
  margin: 0 10rpx 14rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #fff;
  animation: popIn 0.4s ease both;
}

.app-version {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  animation: fadeInUp 0.6s ease 0.15s both;
}

.feedback-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4A90E2;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.15s ease;
  animation: popIn 0.4s ease 0.2s both;
}

.feedback-hover {
  transform: scale(0.94);
}
