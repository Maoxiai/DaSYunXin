/* 数据统计卡片 */
.stats-card {
  margin: 20rpx;
  padding: 32rpx 20rpx;
  background: linear-gradient(135deg, #4A90E2, #6aa6f0);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 226, 0.3);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.35);
}

/* 面板 */
.panel {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: bold;
}

.header-actions {
  display: flex;
  align-items: center;
}

.header-actions .link-btn {
  margin-left: 24rpx;
}

.link-btn {
  font-size: 24rpx;
  color: #4A90E2;
}

/* 列表 */
.list-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
}

.list-row:last-child {
  border-bottom: none;
}

.anim {
  animation: fadeInUp 0.4s ease both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.row-model {
  font-size: 28rpx;
  font-weight: 600;
}

.row-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.row-del {
  padding: 10rpx 6rpx 10rpx 20rpx;
  color: #c2c7d1;
  font-size: 26rpx;
}

.empty-tip {
  padding: 30rpx 0;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

/* 关于 */
.about-text {
  font-size: 25rpx;
  color: #666;
  line-height: 1.8;
}

.about-feedback {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #4A90E2;
}
