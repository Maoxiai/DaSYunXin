.count-bar {
  margin: 20rpx 20rpx 0;
  padding: 24rpx;
  background: linear-gradient(135deg, #4A90E2, #6aa6f0);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.25);
}

.count-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.count-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin: 0 4rpx;
}

.search-box {
  padding: 20rpx 20rpx 0;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #e5e8ef;
  padding: 0 64rpx 0 28rpx;
  border-radius: 36rpx;
  background: #f5f6fa;
  font-size: 28rpx;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #d4d8e0;
  color: #fff;
  font-size: 22rpx;
}

.chip-bar {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.chip {
  padding: 10rpx 24rpx;
  background: #f5f6fa;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
  margin: 0 14rpx 12rpx 0;
}

.chip.active {
  background: rgba(74, 144, 226, 0.12);
  color: #4A90E2;
  font-weight: 600;
}

.list-area {
  padding: 0 20rpx 40rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.anim {
  animation: fadeInUp 0.4s ease both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 删除滑出 */
.list-item.removing {
  animation: slideOutRight 0.26s ease forwards;
}

@keyframes slideOutRight {
  to {
    opacity: 0;
    transform: translateX(120%);
  }
}

.item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-model {
  font-size: 30rpx;
  font-weight: 600;
}

.item-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.item-del {
  padding: 10rpx 6rpx 10rpx 20rpx;
  color: #c2c7d1;
  font-size: 26rpx;
}

.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  animation: floaty 2.6s ease-in-out infinite;
}

@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
