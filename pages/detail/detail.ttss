/* 顶部信息卡 */
.hero {
  background: linear-gradient(135deg, #4A90E2, #5aa0f0);
  padding: 40rpx 30rpx 32rpx;
  color: #fff;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-model {
  font-size: 42rpx;
  font-weight: bold;
}

.fav-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  color: #fff;
}

.fav-active {
  background: rgba(255, 255, 255, 0.25);
  border-color: #ffd04d;
  color: #ffd04d;
}

.hero-badges {
  margin-top: 16rpx;
}

.hero-badges .badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.hero-badges .badge-cat {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.hero-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
}

.hero-actions {
  margin-top: 28rpx;
  display: flex;
}

.btn-primary {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #fff;
  color: #4A90E2;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 38rpx;
  margin-right: 20rpx;
}

.btn-plain {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  font-size: 28rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

/* 参数表 */
.param-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
  font-size: 27rpx;
}

.param-row:last-child {
  border-bottom: none;
}

.param-key {
  width: 180rpx;
  color: #999;
  flex-shrink: 0;
}

.param-val {
  flex: 1;
  color: #333;
  word-break: break-all;
}

/* 替代料 */
.alt-list {
  display: flex;
  flex-wrap: wrap;
}

.alt-tag {
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  margin: 0 16rpx 16rpx 0;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 20rpx 0 60rpx;
}
