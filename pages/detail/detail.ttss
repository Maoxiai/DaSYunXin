/* 顶部信息卡 */
.hero {
  background: linear-gradient(135deg, #4A90E2, #5aa0f0);
  padding: 40rpx 30rpx 32rpx;
  color: #fff;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-model {
  font-size: 42rpx;
  font-weight: bold;
}

.fav-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  color: #fff;
}

.fav-active {
  background: rgba(255, 255, 255, 0.25);
  border-color: #ffd04d;
  color: #ffd04d;
}

.hero-badges {
  margin-top: 16rpx;
}

.hero-badges .badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.hero-badges .badge-cat {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.hero-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
}

/* 参数表 */
.param-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
  font-size: 27rpx;
}

.param-row:last-child {
  border-bottom: none;
}

.param-key {
  width: 180rpx;
  color: #999;
  flex-shrink: 0;
}

.param-val {
  flex: 1;
  color: #333;
  word-break: break-all;
}

/* 引脚表 */
.pin-head {
  display: flex;
  padding: 14rpx 0;
  background: #f5f6fa;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #999;
}

.pin-row {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f7;
}

.pin-row:last-child {
  border-bottom: none;
}

.pin-no {
  width: 90rpx;
  text-align: center;
  color: #4A90E2;
  font-weight: 600;
  font-size: 25rpx;
  font-family: Menlo, Consolas, monospace;
  flex-shrink: 0;
}

.pin-name {
  width: 180rpx;
  font-weight: 600;
  font-size: 25rpx;
  font-family: Menlo, Consolas, monospace;
  flex-shrink: 0;
}

.pin-func {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 替代料 */
.alt-list {
  display: flex;
  flex-wrap: wrap;
}

.alt-tag {
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  margin: 0 16rpx 16rpx 0;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 20rpx 0 60rpx;
}

/* 进入动画 */
.anim-hero {
  animation: slideDown 0.5s ease both;
}

.anim-panel {
  animation: fadeInUp 0.5s ease both;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
