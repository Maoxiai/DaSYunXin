/* 搜索区 */
.search-box {
  padding: 20rpx;
  display: flex;
  align-items: center;
  background: #fff;
}

.input-wrap {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #e5e8ef;
  padding: 0 64rpx 0 28rpx;
  border-radius: 36rpx;
  background: #f5f6fa;
  font-size: 28rpx;
}

.ph {
  color: #b8bdc9;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #d4d8e0;
  color: #fff;
  font-size: 22rpx;
}

.search-btn {
  width: 132rpx;
  height: 72rpx;
  margin-left: 20rpx;
  padding: 0;
  line-height: 72rpx;
  background: #4A90E2;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

/* 自动补全 */
.suggestions {
  margin: 12rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.suggestion-item {
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f2f3f7;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.s-model {
  font-weight: 600;
  font-size: 28rpx;
}

.s-vendor {
  font-size: 22rpx;
  color: #999;
}

/* 通用区块 */
.section {
  margin: 24rpx 20rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
}

.link-btn {
  font-size: 24rpx;
  color: #999;
}

/* 搜索历史标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 30rpx;
  padding: 10rpx 22rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}

.tag-del {
  margin-left: 12rpx;
  color: #c2c7d1;
  font-size: 22rpx;
  padding: 4rpx;
}

/* 热门芯片宫格 */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.chip-tag {
  width: 345rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.chip-tag-model {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-tag-vendor {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 搜索结果 */
.result-area {
  margin: 24rpx 20rpx;
}

.result-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ri-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.ri-model {
  font-size: 32rpx;
  font-weight: bold;
}

.ri-badges {
  display: flex;
  align-items: center;
}

.ri-specs {
  font-size: 24rpx;
  color: #4A90E2;
  margin-bottom: 10rpx;
}

.ri-summary {
  font-size: 26rpx;
  color: #666;
}

/* 空态 */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}
