<!-- 搜索区 -->
<view class="search-box">
  <view class="input-wrap">
    <input
      class="search-input"
      placeholder="输入芯片型号，如 STM32F103"
      placeholder-class="ph"
      value="{{searchKeyword}}"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <view class="clear-btn" tt:if="{{hasInput}}" bindtap="clearInput">✕</view>
  </view>
  <view class="search-btn" hover-class="search-btn-hover" hover-stay-time="80" bindtap="onSearch">
    <view class="shimmer"></view>
    <view class="ripple" tt:for="{{ripples}}" tt:key="id"></view>
    <view class="btn-content">
      <view class="btn-spinner" tt:if="{{isLoading}}"></view>
      <text class="btn-text">{{isLoading ? '搜索中' : '搜索'}}</text>
    </view>
  </view>
</view>

<view class="page-body">
<!-- 自动补全建议 -->
<view class="suggestions" tt:if="{{suggestions.length > 0}}">
  <view
    class="suggestion-item"
    tt:for="{{suggestions}}"
    tt:key="id"
    bindtap="selectSuggestion"
    data-keyword="{{item.model}}"
  >
    <text class="s-model">{{item.model}}</text>
    <text class="s-vendor">{{item.vendor}} · {{item.category}}</text>
  </view>
</view>

<!-- 搜索历史 -->
<view class="section" tt:if="{{history.length > 0 && results === null && suggestions.length === 0}}">
  <view class="section-header">
    <text class="section-title">搜索历史</text>
    <text class="link-btn" bindtap="clearHistory">清空</text>
  </view>
  <view class="tag-list">
    <view class="tag" tt:for="{{history}}" tt:key="*this">
      <text bindtap="tapHistory" data-kw="{{item}}">{{item}}</text>
      <text class="tag-del" catchtap="removeHistoryItem" data-kw="{{item}}">✕</text>
    </view>
  </view>
</view>

<!-- 热门芯片 -->
<view class="section" tt:if="{{results === null && suggestions.length === 0}}">
  <view class="section-header">
    <text class="section-title">热门芯片</text>
  </view>
  <view class="chip-grid">
    <view
      class="chip-tag anim"
      tt:for="{{hotChips}}"
      tt:key="id"
      bindtap="openDetail"
      data-id="{{item.id}}"
      style="animation-delay: {{item._delay}}ms"
    >
      <text class="chip-tag-model">{{item.model}}</text>
      <text class="chip-tag-vendor">{{item.vendor}}</text>
    </view>
  </view>
</view>

<!-- 搜索结果 -->
<view class="result-area" tt:if="{{results !== null}}">
  <block tt:if="{{results.length > 0}}">
    <view
      class="result-item anim"
      tt:for="{{results}}"
      tt:key="id"
      bindtap="openDetail"
      data-id="{{item.id}}"
      style="animation-delay: {{item._delay}}ms"
    >
      <view class="ri-top">
        <text class="ri-model">{{item.model}}</text>
        <view class="ri-badges">
          <text class="badge">{{item.vendor}}</text>
          <text class="badge badge-cat">{{item.category}}</text>
        </view>
      </view>
      <view class="ri-specs">{{item.spec}}</view>
      <view class="ri-summary">{{item.summary}}</view>
    </view>
  </block>

  <!-- 空态 -->
  <view class="empty" tt:if="{{results.length === 0 && !isLoading}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到「{{searchKeyword}}」相关芯片</text>
    <text class="empty-tip">换个关键词试试，或点击上方重新搜索</text>
  </view>
</view>

<!-- 加载提示 -->
<view class="loading" tt:if="{{isLoading}}">加载中...</view>
</view>
