<!-- 顶部切换 -->
<view class="tab-bar">
  <view class="tab-item {{activeTab === 'vendor' ? 'active' : ''}}" bindtap="switchTab" data-tab="vendor">按厂商</view>
  <view class="tab-item {{activeTab === 'category' ? 'active' : ''}}" bindtap="switchTab" data-tab="category">按品类</view>
</view>

<!-- 厂商宫格 -->
<view class="grid" tt:if="{{activeTab === 'vendor'}}">
  <view
    class="grid-item"
    tt:for="{{vendorGroups}}"
    tt:key="name"
    bindtap="openList"
    data-type="vendor"
    data-value="{{item.name}}"
  >
    <text class="gi-name">{{item.name}}</text>
    <text class="gi-count">{{item.count}} 款</text>
  </view>
</view>

<!-- 品类宫格 -->
<view class="grid" tt:if="{{activeTab === 'category'}}">
  <view
    class="grid-item"
    tt:for="{{categoryGroups}}"
    tt:key="name"
    bindtap="openList"
    data-type="category"
    data-value="{{item.name}}"
  >
    <text class="gi-name">{{item.name}}</text>
    <text class="gi-count">{{item.count}} 款</text>
  </view>
</view>

<view class="foot-tip">持续扩充芯片库中，未收录型号可在首页搜索反馈</view>
